#include <stdio.h>
#include <limits.h>
#include <stdbool.h>

#define INF INT_MAX
#define NUM_ROUTERS 4  // Number of routers

typedef struct {
    char name;
    int linkState[NUM_ROUTERS];  // Distance to other routers
    int shortestPaths[NUM_ROUTERS]; // Shortest path distances
    bool visited[NUM_ROUTERS];  // Visited flags for Dijkstra
} Router;

void printShortestPaths(Router *router) {
    printf("Shortest paths from Router %c:\n", router->name);
    for (int i = 0; i < NUM_ROUTERS; i++) {
        if (router->shortestPaths[i] == INF)
            printf("To Router %c: INF\n", 'A' + i);
        else
            printf("To Router %c: %d\n", 'A' + i, router->shortestPaths[i]);
    }
}

void dijkstra(Router *router, Router routers[]) {
    int n = NUM_ROUTERS;
    for (int i = 0; i < n; i++) {
        router->shortestPaths[i] = INF;
        router->visited[i] = false;
    }
    router->shortestPaths[0] = 0;

    for (int count = 0; count < n - 1; count++) {
        int min = INF, u = -1;
        for (int v = 0; v < n; v++) {
            if (!router->visited[v] && router->shortestPaths[v] < min) {
                min = router->shortestPaths[v];
                u = v;
            }
        }
        
        router->visited[u] = true;

        for (int v = 0; v < n; v++) {
            if (!router->visited[v] && routers[u].linkState[v] != INF && 
                router->shortestPaths[u] + routers[u].linkState[v] < router->shortestPaths[v]) {
                router->shortestPaths[v] = router->shortestPaths[u] + routers[u].linkState[v];
            }
        }
    }
}

int main() {
    Router routers[NUM_ROUTERS] = {
        {'A', {0, 1, 3, INF}, {INF, INF, INF, INF}, {false, false, false, false}},
        {'B', {1, 0, 1, 4}, {INF, INF, INF, INF}, {false, false, false, false}},
        {'C', {3, 1, 0, 1}, {INF, INF, INF, INF}, {false, false, false, false}},
        {'D', {INF, 4, 1, 0}, {INF, INF, INF, INF}, {false, false, false, false}}
    };

    for (int i = 0; i < NUM_ROUTERS; i++) {
        dijkstra(&routers[i], routers);
        printShortestPaths(&routers[i]);
    }

    return 0;
}
